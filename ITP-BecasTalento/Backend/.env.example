# Puerto del servidor
PORT=3000

# Conexión a Base de Datos PostgreSQL / Supabase
# Para Supabase usar Connection Pooling (Transaction / Session) o Direct Connection con SSL
DATABASE_URL="postgresql://postgres.[PROYECTO]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Seguridad y Autenticación JWT
JWT_SECRET="super_secret_jwt_itp_becas_talento_change_in_production"
JWT_EXPIRES_IN="24h"

# URL del Frontend (para CORS)
FRONTEND_URL="http://localhost:5173"

# Entorno
NODE_ENV="development"